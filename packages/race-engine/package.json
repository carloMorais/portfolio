{
  "name": "race-engine",
  "version": "0.1.0",
  "private": true,
  "description": "RaceGame's deterministic engine: physics, collisions, race rules and bots, shared by the browser and the server.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
