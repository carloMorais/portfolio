{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "RaceGame's online mode gateway (fase 3.4) and health check for Render.",
  "scripts": {
    "prebuild": "npm run build -w race-engine",
    "build": "nest build",
    "start": "node dist/main.js",
    "prestart:dev": "npm run build -w race-engine",
    "start:dev": "nest start --watch",
    "lint": "eslint",
    "pretypecheck": "npm run build -w race-engine",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build -w race-engine",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-ws": "^11.2.7",
    "@nestjs/websockets": "^11.2.7",
    "race-engine": "*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/ws": "^8.18.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
